<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.parcial.controller.ServiciosController" styleClass="pestana">
    <top>
        <VBox spacing="8" styleClass="formulario-arriba">
            <Label text="Servicio adicional" styleClass="titulo-seccion"/>
            <FlowPane hgap="10" vgap="8">
                <VBox spacing="3"><Label text="Código"/><TextField fx:id="txtCodigo" prefWidth="80"/></VBox>
                <VBox spacing="3"><Label text="Nombre"/><TextField fx:id="txtNombre" prefWidth="180"/></VBox>
                <VBox spacing="3"><Label text="Descripción"/><TextField fx:id="txtDescripcion" prefWidth="220"/></VBox>
                <VBox spacing="3"><Label text="Precio"/><TextField fx:id="txtPrecio" prefWidth="110"/></VBox>
                <VBox spacing="3"><Label text="Disponible"/><CheckBox fx:id="chkDisponible"/></VBox>
            </FlowPane>
            <HBox spacing="6">
                <Button text="Registrar" onAction="#registrar"/>
                <Button text="Actualizar" onAction="#actualizar"/>
                <Button text="Eliminar" onAction="#eliminar"/>
                <Button text="Limpiar" onAction="#limpiar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCodigo" text="Código"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colDescripcion" text="Descripción"/>
                <TableColumn fx:id="colPrecio" text="Precio"/>
                <TableColumn fx:id="colDisponible" text="Disponible"/>
            </columns>
            <placeholder><Label text="No hay servicios registrados"/></placeholder>
        </TableView>
    </center>
</BorderPane>