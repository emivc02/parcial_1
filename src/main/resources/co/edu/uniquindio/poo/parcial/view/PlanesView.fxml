<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.parcial.controller.PlanesController" styleClass="pestana">
    <top>
        <VBox spacing="8" styleClass="formulario-arriba">
            <Label text="Plan de entrenamiento" styleClass="titulo-seccion"/>
            <FlowPane hgap="10" vgap="8">
                <VBox spacing="3"><Label text="Tipo de plan"/><ComboBox fx:id="cbTipo" prefWidth="130"/></VBox>
                <VBox spacing="3"><Label text="Código"/><TextField fx:id="txtCodigo" prefWidth="80"/></VBox>
                <VBox spacing="3"><Label text="Nombre"/><TextField fx:id="txtNombre" prefWidth="160"/></VBox>
                <VBox spacing="3"><Label text="Descripción"/><TextField fx:id="txtDescripcion" prefWidth="180"/></VBox>
                <VBox spacing="3"><Label text="Duración (meses)"/><TextField fx:id="txtDuracion" prefWidth="100"/></VBox>
                <VBox spacing="3"><Label text="Valor mensual"/><TextField fx:id="txtValorMensual" prefWidth="110"/></VBox>
                <VBox spacing="3"><Label text="Estado"/><ComboBox fx:id="cbEstado" prefWidth="120"/></VBox>
                <GridPane fx:id="panelPersonalizado" hgap="10" vgap="3">
                    <Label text="Sesiones" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtSesiones" prefWidth="70" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label text="Especialidad" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtEspecialidad" prefWidth="120" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Objetivo" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtObjetivo" prefWidth="160" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>
            </FlowPane>
            <HBox spacing="6">
                <Button text="Registrar" onAction="#registrar"/>
                <Button text="Actualizar" onAction="#actualizar"/>
                <Button text="Eliminar" onAction="#eliminar"/>
                <Button text="Limpiar" onAction="#limpiar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCodigo" text="Código"/>
                <TableColumn fx:id="colTipo" text="Tipo"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colDuracion" text="Duración"/>
                <TableColumn fx:id="colValorMensual" text="Valor mensual"/>
                <TableColumn fx:id="colValorTotal" text="Valor total"/>
                <TableColumn fx:id="colEstado" text="Estado"/>
                <TableColumn fx:id="colBeneficios" text="Beneficios"/>
            </columns>
            <placeholder><Label text="No hay planes registrados"/></placeholder>
        </TableView>
    </center>
</BorderPane>